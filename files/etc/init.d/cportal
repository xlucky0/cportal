#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NFT_SH=/usr/libexec/cportal/nft.sh
WWW=/usr/share/cportal/www

start_service() {
	local enabled port
	config_load cportal
	config_get_bool enabled main enabled 1
	config_get port main portal_port 2050
	[ "$enabled" = 1 ] || return 0

	"$NFT_SH" up || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -p "0.0.0.0:$port" \
		-h "$WWW" -E /cgi-bin/portal -t 10 -T 10 -n 10 -N 50
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$NFT_SH" down
}

# reload hanya menyusun ulang aturan (sesi login yang aktif tetap hidup)
reload_service() {
	local enabled
	config_load cportal
	config_get_bool enabled main enabled 1
	if [ "$enabled" = 1 ]; then
		"$NFT_SH" up
	else
		"$NFT_SH" down
	fi
}

service_triggers() {
	procd_add_reload_trigger cportal
}
